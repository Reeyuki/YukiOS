{
  "name": "yukios-desktop",
  "private": true,
  "version": "0.0.0",
  "description": "YukiOS — a browser-based desktop environment, also packaged as a native app with Electron.",
  "keywords": [
    "webos",
    "web-desktop",
    "desktop-environment",
    "electron",
    "vite",
    "pwa"
  ],
  "homepage": "https://github.com/Reeyuki/YukiOS#readme",
  "bugs": {
    "url": "https://github.com/Reeyuki/YukiOS/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Reeyuki/YukiOS.git",
    "directory": "webos-desktop"
  },
  "author": {
    "name": "Reeyuki",
    "url": "https://github.com/Reeyuki"
  },
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.6.0+sha512.9a36518224080c6fe5165afdcfe79bfa118c29be703f3f462b1e32efe1e98e47e8750b148e08286250aad4113cc7993ca413c4e2cd447752708c2ee5751bc95f",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "prebuild": "node scripts/validateRegistry.js && node scripts/generateAppList.js && node scripts/fetchFavicons.js",
    "validate": "node scripts/validateRegistry.js",
    "validate:strict": "node scripts/validateRegistry.js --strict",
    "generate:apps": "node scripts/generateAppList.js",
    "generate:sitemap": "node scripts/generateSitemap.js",
    "generate:papirus": "node scripts/generatePapirusData.js",
    "favicons": "node scripts/fetchFavicons.js",
    "favicons:force": "node scripts/fetchFavicons.js --force",
    "build": "vite build",
    "build:dev": "cross-env VITE_DEV_BUILD=true vite build",
    "build:single": "cross-env VITE_SINGLE_FILE=true vite build",
    "build:site": "pnpm prebuild && vite build && node scripts/prepareSelfHost.js",
    "build:dev:single": "cross-env VITE_SINGLE_FILE=true VITE_DEV_BUILD=true vite build",
    "build:electron": "cross-env VITE_SINGLE_FILE=false VITE_ELECTRON=true vite build",
    "electron:prepare": "pnpm build:electron && node scripts/removeDistFavicon.cjs",
    "electron:dev": "pnpm electron:prepare && electron .",
    "electron:build": "pnpm electron:prepare && electron-builder",
    "electron:build:win": "pnpm electron:prepare && electron-builder --win",
    "electron:build:linux": "pnpm electron:prepare && electron-builder --linux",
    "electron:build:mac": "pnpm electron:prepare && electron-builder --mac",
    "lint": "eslint . --ext .js,.jsx",
    "lint:fix": "eslint . --ext .js,.jsx --fix",
    "format": "prettier --write --end-of-line auto --cache --cache-location=.prettier-cache \"**/*.{js,jsx,css,json,html}\"",
    "format:check": "prettier --check --end-of-line auto --cache --cache-location=.prettier-cache \"**/*.{js,jsx,css,json,html}\"",
    "format:changed": "git diff --name-only HEAD --diff-filter=ACMR | grep '^webos-desktop/' | sed 's#^webos-desktop/##' | grep -E '\\.(js|jsx|css|json|html)$' | xargs -r pnpm exec prettier --write --end-of-line auto --cache --cache-location=.prettier-cache",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm lint && pnpm format:check && pnpm test",
    "bd": "pnpm build:dev",
    "b": "pnpm build && cp -r dist/* ../desktop/",
    "b:single": "pnpm build:single && cp -r dist/* ../desktop/",
    "bf": "pnpm format:changed && pnpm build:dev && cp -r dist/* ../desktop/"
  },
  "dependencies": {
    "7z-wasm": "^1.2.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@mercuryworkshop/libcurl-transport": "^2.0.5",
    "@ruffle-rs/ruffle": "0.2.0-nightly.2026.5.15",
    "@webcontainer/api": "^1.6.4",
    "archive-wasm": "^1.7.1",
    "cannon-es": "^0.20.0",
    "canvas-confetti": "^1.9.4",
    "clippyjs": "^0.1.0",
    "docx": "^8.6.0",
    "emoji-mart": "^5.6.0",
    "eruda": "^2.11.3",
    "fflate": "^0.8.3",
    "gsap": "^3.15.0",
    "handsontable": "^12.4.0",
    "html2canvas": "^1.4.1",
    "html2canvas-pro": "^1.6.7",
    "interactjs": "^1.10.28",
    "isomorphic-git": "^1.41.4",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.1",
    "marked": "^17.0.6",
    "monaco-editor": "^0.45.0",
    "parse-torrent": "^11.0.24",
    "pdfjs-dist": "^3.11.174",
    "three": "^0.134.0",
    "vanta": "^0.5.24",
    "webtorrent": "^2.8.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "cross-env": "^10.1.0",
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.1.1",
    "sharp": "^0.33.4",
    "vite": "^7.3.6",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "app.yukios.desktop",
    "productName": "YukiOS",
    "copyright": "Copyright © Reeyuki",
    "npmRebuild": false,
    "asar": true,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "dist/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "YukiOS"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "dist/icons/icon-512.png",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "dist/icons/icon-256.png",
      "category": "Utility",
      "synopsis": "A web-based desktop environment",
      "maintainer": "Reeyuki"
    }
  }
}
