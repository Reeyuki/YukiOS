{
  "name": "yukios-desktop",
  "private": true,
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Reeyuki/YukiOS.git"
  },
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/validateRegistry.js && node scripts/generateAppList.js",
    "build": "vite build",
    "build:dev": "VITE_DEV_BUILD=true vite build",
    "build:single": "cross-env VITE_SINGLE_FILE=true vite build",
    "build:electron": "cross-env VITE_SINGLE_FILE=false VITE_ELECTRON=true vite build",
    "build:dev:single": "cross-env VITE_SINGLE_FILE=true VITE_DEV_BUILD=true vite build",
    "bd": "cross-env VITE_DEV_BUILD=true vite build",
    "b": "pnpm build && cp -r dist/* ../desktop/",
    "b:single": "pnpm build:single && cp -r dist/* ../desktop/",
    "bf": "pnpm format && pnpm build:dev && cp -r dist/* ../desktop/",
    "build-win": "vite build",
    "preview": "vite preview",
    "format": "git diff --name-only HEAD --diff-filter=ACMR | grep '^webos-desktop/' | sed 's#^webos-desktop/##' | grep -E '\\.(js|jsx|css|json|html)$' | xargs -r pnpm exec prettier --write --cache --cache-location=.prettier-cache",
    "lint": "eslint . --ext .js,.jsx --fix",
    "electron:dev": "pnpm build:electron && node -e \"require('fs').existsSync('dist/favicon.ico')&&require('fs').unlinkSync('dist/favicon.ico')\" && electron .",
    "electron:build": "pnpm build:electron && node -e \"require('fs').existsSync('dist/favicon.ico')&&require('fs').unlinkSync('dist/favicon.ico')\" && electron-builder --config",
    "electron:build:win": "pnpm build:electron && node -e \"require('fs').existsSync('dist/favicon.ico')&&require('fs').unlinkSync('dist/favicon.ico')\" && electron-builder --win --config",
    "electron:build:linux": "pnpm build:electron && node -e \"require('fs').existsSync('dist/favicon.ico')&&require('fs').unlinkSync('dist/favicon.ico')\" && electron-builder --linux --config",
    "electron:build:mac": "pnpm build:electron && node -e \"require('fs').existsSync('dist/favicon.ico')&&require('fs').unlinkSync('dist/favicon.ico')\" && electron-builder --mac --config",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "cross-env": "^10.1.0",
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.1.1",
    "vite": "^7.3.6",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "7z-wasm": "^1.2.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@mercuryworkshop/libcurl-transport": "^2.0.5",
    "@ruffle-rs/ruffle": "0.2.0-nightly.2026.5.15",
    "@webcontainer/api": "^1.6.4",
    "archive-wasm": "^1.7.1",
    "cannon-es": "^0.20.0",
    "canvas-confetti": "^1.9.4",
    "clippyjs": "^0.1.0",
    "docx": "^8.6.0",
    "emoji-mart": "^5.6.0",
    "eruda": "^2.11.3",
    "fflate": "^0.8.3",
    "globals": "^17.11.0",
    "gsap": "^3.15.0",
    "handsontable": "^12.4.0",
    "html2canvas": "^1.4.1",
    "html2canvas-pro": "^1.6.7",
    "interactjs": "^1.10.28",
    "isomorphic-git": "^1.41.4",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.1",
    "marked": "^17.0.6",
    "monaco-editor": "^0.45.0",
    "parse-torrent": "^11.0.24",
    "pdfjs-dist": "^3.11.174",
    "three": "^0.134.0",
    "vanta": "^0.5.24",
    "webtorrent": "^2.8.5",
    "xlsx": "^0.18.5"
  },
  "packageManager": "pnpm@11.6.0+sha512.9a36518224080c6fe5165afdcfe79bfa118c29be703f3f462b1e32efe1e98e47e8750b148e08286250aad4113cc7993ca413c4e2cd447752708c2ee5751bc95f",
  "build": {
    "npmRebuild": false,
    "appId": "app.yukios.desktop",
    "productName": "YukiOS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "dist/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "dist/icons/icon-512.png",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "dist/icons/icon-256.png",
      "category": "Utility"
    }
  }
}
