{
  "name": "webos-desktop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/validateRegistry.js",
    "build": "vite build",
    "build:dev": "VITE_DEV_BUILD=true vite build",
    "build:single": "VITE_SINGLE_FILE=true vite build",
    "build:dev:single": "VITE_SINGLE_FILE=true VITE_DEV_BUILD=true vite build",
    "bd": "VITE_DEV_BUILD=true vite build",
    "b": "pnpm build && cp -r dist/* ../desktop/",
    "b:single": "pnpm build:single && cp -r dist/* ../desktop/",
    "bf": "pnpm format && pnpm build:dev && cp -r dist/* ../desktop/",
    "build-win": "vite build",
    "preview": "vite preview",
    "format": "pnpm exec prettier --write --cache --cache-location=.prettier-cache src",
    "lint": "eslint . --ext .js,.jsx --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.9.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "^6.0.3",
    "vite": "^7.3.5",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "7z-wasm": "^1.2.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@ruffle-rs/ruffle": "0.2.0-nightly.2026.5.15",
    "archive-wasm": "^1.7.1",
    "canvas-confetti": "^1.9.4",
    "clippyjs": "^0.1.0",
    "docx": "^8.6.0",
    "emoji-mart": "^5.6.0",
    "eruda": "^2.11.3",
    "fflate": "^0.8.3",
    "globals": "^17.7.0",
    "handsontable": "^12.4.0",
    "html2canvas": "^1.4.1",
    "html2canvas-pro": "^1.6.7",
    "interactjs": "^1.10.27",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "marked": "^17.0.6",
    "monaco-editor": "^0.45.0",
    "parse-torrent": "^11.0.21",
    "pdfjs-dist": "^3.11.174",
    "three": "^0.134.0",
    "vanta": "^0.5.24",
    "webtorrent": "^2.8.5",
    "xlsx": "^0.18.5"
  },
  "packageManager": "pnpm@11.6.0+sha512.9a36518224080c6fe5165afdcfe79bfa118c29be703f3f462b1e32efe1e98e47e8750b148e08286250aad4113cc7993ca413c4e2cd447752708c2ee5751bc95f"
}
